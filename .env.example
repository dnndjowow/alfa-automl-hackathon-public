# Скопировать в .env (он в .gitignore) и заполнить значениями, полученными в командном чате.
# Ключ, адрес и модель выдают организаторы; в репозиторий их не коммитить.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
# Короткий локальный прогон, чтобы не тратить дневной бюджет (600 руб): секунды и шаги диалога.
# AGENT_TIME_LIMIT=1200
# AGENT_MAX_STEPS=12
